// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model ConstructionSite {
  site_id Int @id @default(autoincrement())
  address String
  site_name String
  latitude Float
  longitude Float
  created_at DateTime @default(now())
  DroneSurvey DroneSurvey[]
  reports Report[]
}
enum SurveyStatus {
  PENDING
  COMPLETED
  CANCELLED
}
model DroneSurvey {
  survey_id Int @id @default(autoincrement())
  site_id Int
  site ConstructionSite @relation(fields: [site_id], references: [site_id])
  survey_date DateTime  @default(now())
  survey_status SurveyStatus @default(PENDING)
  remarks String?
  reports Report[]
}
enum ReportStatus {
  PENDING
  UNDER_INVESTIGATION
  VERIFIED
  REJECTED
}

model Report {
  report_id   Int          @id @default(autoincrement())
  site_id     Int
  survey_id   Int?
  description String
  report_date DateTime     @default(now())
  status      ReportStatus @default(PENDING)

  site         ConstructionSite @relation(fields: [site_id], references: [site_id])
  survey       DroneSurvey?     @relation(fields: [survey_id], references: [survey_id])
  investigation Investigation?
}
enum InvestigationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Investigation {
  investigation_id     Int      @id @default(autoincrement())
  report_id            Int      @unique
  investigation_date   DateTime?
  investigation_notes  String?
  investigation_status InvestigationStatus @default(NOT_STARTED)

  report Report @relation(fields: [report_id], references: [report_id])
}

enum Role {
  ADMIN
  OFFICER
  SURVEYOR
  VIEWER
}

model User {
  user_id       Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(OFFICER)
  created_at    DateTime @default(now())
}